rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /employees/{path=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /offsite/{path=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
